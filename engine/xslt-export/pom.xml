<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.flottila.mapping</groupId>
    <artifactId>flottila-mapping-engine</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>flottila-mapping-xslt-export</artifactId>
  <name>Flottila Mapping xslt-export</name>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>flottila-mapping-mapping</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>flottila-mapping-ir</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>flottila-mapping-structure</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <!-- the module's own resources, which a resources list would otherwise drop -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- the helper module po-runtime.xsl (ADR-0023), which the build joins from core.xsl and the
           family modules in src/main/xsl/po-runtime (ADR-0025 "Families", F-15) -->
      <resource>
        <directory>${project.build.directory}/generated-resources/function-families</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>function-families</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/scripts/function-families.java</argument>
                <argument>helper</argument>
                <argument>${project.build.directory}/generated-resources/function-families/io/flottila/mapping/xslt/export/po-runtime.xsl</argument>
                <argument>${project.basedir}/src/main/xsl/po-runtime</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
