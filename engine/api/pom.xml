<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.flottila.mapping</groupId>
    <artifactId>flottila-mapping-engine</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>flottila-mapping-api</artifactId>
  <name>Flottila Mapping api</name>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>flottila-mapping-mapping</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>flottila-mapping-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>flottila-mapping-structure-import</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>flottila-mapping-xslt-export</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>flottila-mapping-udf</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <configuration>
            <!-- PIT only; Surefire still runs it: it reads ModuleLayer.boot(), which is empty on
                 PIT's class path (docs/findings/F-10.md) -->
            <excludedTestClasses>
              <param>io.flottila.mapping.api.DiagnosticCatalogueTest</param>
            </excludedTestClasses>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- the root's @{argLine} (JaCoCo) first; EngineFacadeTraceTest's fake clock takes
               Tracer's private lock by reflection (#103) -->
          <argLine>@{argLine} --add-opens io.flottila.mapping.runtime/io.flottila.mapping.runtime=io.flottila.mapping.api</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
