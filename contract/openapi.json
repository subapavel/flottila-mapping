{
  "openapi" : "3.1.0",
  "components" : {
    "schemas" : {
      "AuthoringIdLocation" : {
        "type" : "object",
        "required" : [ "kind", "authoringId" ],
        "properties" : {
          "kind" : {
            "type" : "string",
            "const" : "authoring-id"
          },
          "authoringId" : {
            "type" : "string"
          }
        }
      },
      "CreateMappingRequest" : {
        "type" : "object",
        "required" : [ "id", "source", "target" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "source" : {
            "$ref" : "#/components/schemas/StructureChoice"
          },
          "target" : {
            "$ref" : "#/components/schemas/StructureChoice"
          }
        }
      },
      "DiagnosticDto" : {
        "type" : "object",
        "required" : [ "severity", "code", "message", "location" ],
        "properties" : {
          "severity" : {
            "type" : "string",
            "enum" : [ "error", "warning" ]
          },
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "location" : {
            "$ref" : "#/components/schemas/LocationDto"
          }
        }
      },
      "FieldDto" : {
        "type" : "object",
        "required" : [ "kind", "step", "namespace", "localName", "min", "nillable" ],
        "properties" : {
          "kind" : {
            "type" : "string",
            "enum" : [ "element", "attribute" ]
          },
          "step" : {
            "type" : "string"
          },
          "namespace" : {
            "type" : "string"
          },
          "localName" : {
            "type" : "string"
          },
          "min" : {
            "type" : "integer",
            "format" : "int64"
          },
          "max" : {
            "type" : "integer",
            "format" : "int64"
          },
          "valueType" : {
            "type" : "string"
          },
          "nillable" : {
            "type" : "boolean"
          },
          "type" : {
            "type" : "string"
          }
        }
      },
      "FilePositionLocation" : {
        "type" : "object",
        "required" : [ "kind", "file", "line", "column" ],
        "properties" : {
          "kind" : {
            "type" : "string",
            "const" : "file-position"
          },
          "file" : {
            "type" : "string"
          },
          "line" : {
            "type" : "integer",
            "format" : "int32"
          },
          "column" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "LocationDto" : {
        "oneOf" : [ {
          "$ref" : "#/components/schemas/PointerLocation"
        }, {
          "$ref" : "#/components/schemas/AuthoringIdLocation"
        }, {
          "$ref" : "#/components/schemas/FilePositionLocation"
        } ],
        "discriminator" : {
          "propertyName" : "kind",
          "mapping" : {
            "pointer" : "#/components/schemas/PointerLocation",
            "authoring-id" : "#/components/schemas/AuthoringIdLocation",
            "file-position" : "#/components/schemas/FilePositionLocation"
          }
        },
        "type" : "object"
      },
      "MappingSummary" : {
        "type" : "object",
        "required" : [ "id", "name" ],
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        }
      },
      "PointerLocation" : {
        "type" : "object",
        "required" : [ "kind", "pointer" ],
        "properties" : {
          "kind" : {
            "type" : "string",
            "const" : "pointer"
          },
          "pointer" : {
            "type" : "string"
          }
        }
      },
      "StructureChoice" : {
        "type" : "object",
        "required" : [ "bundle", "root" ],
        "properties" : {
          "bundle" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "root" : {
            "$ref" : "./mapping-model.schema.json#/$defs/rootSelector"
          }
        }
      },
      "StructureLoaded" : {
        "type" : "object",
        "required" : [ "kind", "fingerprint", "root", "types" ],
        "properties" : {
          "kind" : {
            "type" : "string",
            "const" : "loaded"
          },
          "fingerprint" : {
            "type" : "string"
          },
          "root" : {
            "$ref" : "#/components/schemas/FieldDto"
          },
          "types" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "array",
              "items" : {
                "$ref" : "#/components/schemas/FieldDto"
              }
            }
          }
        }
      },
      "StructureRefused" : {
        "type" : "object",
        "required" : [ "kind", "diagnostics" ],
        "properties" : {
          "kind" : {
            "type" : "string",
            "const" : "refused"
          },
          "diagnostics" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DiagnosticDto"
            }
          }
        }
      },
      "StructureRequest" : {
        "type" : "object",
        "required" : [ "base", "bundle", "root" ],
        "properties" : {
          "base" : {
            "type" : "string"
          },
          "bundle" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "root" : {
            "$ref" : "./mapping-model.schema.json#/$defs/rootSelector"
          }
        }
      },
      "StructureResponse" : {
        "oneOf" : [ {
          "$ref" : "#/components/schemas/StructureLoaded"
        }, {
          "$ref" : "#/components/schemas/StructureRefused"
        } ],
        "discriminator" : {
          "propertyName" : "kind",
          "mapping" : {
            "loaded" : "#/components/schemas/StructureLoaded",
            "refused" : "#/components/schemas/StructureRefused"
          }
        },
        "type" : "object"
      },
      "TestOutput" : {
        "type" : "object",
        "required" : [ "kind", "output", "diagnostics" ],
        "properties" : {
          "kind" : {
            "type" : "string",
            "const" : "output"
          },
          "output" : {
            "type" : "string"
          },
          "diagnostics" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DiagnosticDto"
            }
          }
        }
      },
      "TestRefused" : {
        "type" : "object",
        "required" : [ "kind", "diagnostics" ],
        "properties" : {
          "kind" : {
            "type" : "string",
            "const" : "refused"
          },
          "diagnostics" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DiagnosticDto"
            }
          }
        }
      },
      "TestRequest" : {
        "type" : "object",
        "required" : [ "model", "input" ],
        "properties" : {
          "model" : {
            "$ref" : "./mapping-model.schema.json"
          },
          "input" : {
            "type" : "string"
          }
        }
      },
      "TestResult" : {
        "oneOf" : [ {
          "$ref" : "#/components/schemas/TestOutput"
        }, {
          "$ref" : "#/components/schemas/TestRefused"
        } ],
        "discriminator" : {
          "propertyName" : "kind",
          "mapping" : {
            "output" : "#/components/schemas/TestOutput",
            "refused" : "#/components/schemas/TestRefused"
          }
        },
        "type" : "object"
      }
    }
  },
  "paths" : {
    "/api/mappings" : {
      "get" : {
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/MappingSummary"
                  }
                }
              }
            }
          }
        },
        "summary" : "List",
        "tags" : [ "Mappings Resource" ]
      },
      "post" : {
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateMappingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "The new mapping in canonical form, with its ETag and Location",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "./mapping-model.schema.json"
                }
              }
            }
          }
        },
        "summary" : "Create",
        "tags" : [ "Mappings Resource" ]
      }
    },
    "/api/mappings/{id}" : {
      "put" : {
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : ".+"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "./mapping-model.schema.json"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "The saved mapping in canonical form, with its new ETag",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "./mapping-model.schema.json"
                }
              }
            }
          }
        },
        "summary" : "Save",
        "tags" : [ "Mappings Resource" ]
      },
      "get" : {
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : ".+"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The mapping in canonical form, with its ETag",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "./mapping-model.schema.json"
                }
              }
            }
          }
        },
        "summary" : "Get",
        "tags" : [ "Mappings Resource" ]
      }
    },
    "/api/mappings/{id}/test" : {
      "post" : {
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : ".+"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TestRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TestResult"
                }
              }
            }
          }
        },
        "summary" : "Test",
        "tags" : [ "Mappings Resource" ]
      }
    },
    "/api/structures" : {
      "post" : {
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/StructureRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StructureResponse"
                }
              }
            }
          }
        },
        "summary" : "Load",
        "tags" : [ "Structures Resource" ]
      }
    }
  },
  "info" : {
    "title" : "flottila-mapping-service API",
    "version" : "0.1.0-SNAPSHOT"
  }
}