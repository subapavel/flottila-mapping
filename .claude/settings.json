{
  "model": "claude-opus-5-5",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 400000,
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push origin:*)",
      "Bash(git merge:*)",
      "Bash(git commit:*)",
      "Bash(git worktree:*)",
      "Bash(gh api repos/subapavel/flottila-mapping/:*)",
      "Bash(gh api -X POST repos/subapavel/flottila-mapping/:*)",
      "Bash(gh api -X PATCH repos/subapavel/flottila-mapping/:*)",
      "Bash(gh api -X PUT repos/subapavel/flottila-mapping/:*)",
      "Bash(./mvnw:*)",
      "Bash(scripts/:*)",
      "Bash(bash scripts/:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)"
    ]
  },
  "subagentPromptCacheTtl": "1h",
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL": "1h"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "h=~/.claude/stop-hook-git-check.sh; g=\"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/stop-hook-git-check.gated.sh\"; if [ -f \"$h\" ] && [ -f \"$g\" ] && ! grep -q batch-in-review \"$h\"; then cp \"$h\" ~/.claude/stop-hook-git-check.orig.sh && cp \"$g\" \"$h\" && chmod +x \"$h\" && echo 'gated stop hook installed'; fi"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'context compacted - re-verify before changing anything (CLAUDE.md, Context hygiene):'; git status --short | head -20; git log -3 --oneline; git worktree list; echo '--- agent/HANDOFF.md'; head -c 4000 agent/HANDOFF.md"
          }
        ]
      }
    ]
  }
}
