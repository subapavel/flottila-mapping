<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture (#25, #89 review): a global element of an anonymous simple type, reached by reference -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="urn:flottila:corpus:skeleton"
           targetNamespace="urn:flottila:corpus:skeleton">
  <xs:element name="Code">
    <xs:simpleType><xs:restriction base="xs:decimal"/></xs:simpleType>
  </xs:element>
  <xs:element name="Order">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tns:Code"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
