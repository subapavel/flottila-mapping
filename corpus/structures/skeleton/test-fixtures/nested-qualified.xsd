<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture (#62): elementFormDefault="qualified" puts every local element, at any depth, in the
     target namespace -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:flottila:corpus:skeleton" elementFormDefault="qualified">
  <xs:element name="Order">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Line" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Sku" type="xs:token"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="channel" type="xs:string"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
