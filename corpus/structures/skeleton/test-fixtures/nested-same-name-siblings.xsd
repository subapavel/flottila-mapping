    <xs:complexType>
      <xs:sequence>
        <xs:element name="Part">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="A" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Part">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="B" type="xs:int"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
