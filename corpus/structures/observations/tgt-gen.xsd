<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic target for obs-target-creation (ADR-0018): Gen is 2..3 under a repeating Grp, for a
     generating function on a target and the numbering of its children. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">
  <xs:element name="Gens">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Grp" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Gen" minOccurs="2" maxOccurs="3">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="V" type="xs:string" minOccurs="0" maxOccurs="1"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
