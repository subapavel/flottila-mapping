<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic target for obs-structures (ADR-0018, #91): the root Coded carries the required
     attribute code, which stays unmapped, and the optional repeating leaf V. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">
  <xs:element name="Coded">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="V" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="code" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
