<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic target for obs-structures str-attr (ADR-0018, #102): the root Flagged carries the
     optional attribute flag and the required attribute code, and holds the optional repeating
     leaf V. No namespace. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">
  <xs:element name="Flagged">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="V" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="flag" type="xs:string"/>
      <xs:attribute name="code" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
