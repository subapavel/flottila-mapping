<?xml version="1.0" encoding="UTF-8"?>
<!-- Generic synthetic target for the observation kit (ADR-0018): Item per parent occurrence with
     V and W below it, and All directly under the root. Every field is a string. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">
  <xs:element name="Out">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Item" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="V" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="W" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="All" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
