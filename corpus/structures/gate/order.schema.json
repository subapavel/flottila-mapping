{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic JSON order for GATE check 1 (#100): $defs and $ref, allOf, oneOf, an array of objects and a nullable type list",
  "type": "object",
  "required": ["id", "customer", "lines"],
  "properties": {
    "id": {"type": "string"},
    "issued": {"type": "string", "format": "date"},
    "customer": {"$ref": "#/$defs/customer"},
    "delivery": {
      "type": "object",
      "oneOf": [
        {"properties": {"address": {"$ref": "#/$defs/address"}}},
        {"properties": {"pickup": {"type": "string"}}}
      ]
    },
    "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line"}},
    "note": {"type": ["string", "null"]}
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string"}}
    },
    "customer": {
      "allOf": [
        {"$ref": "#/$defs/party"},
        {"type": "object", "required": ["number"], "properties": {"number": {"type": "string"}}}
      ]
    },
    "address": {
      "type": "object",
      "properties": {"street": {"type": "string"}, "city": {"type": "string"}}
    },
    "line": {
      "type": "object",
      "required": ["no", "sku", "quantity", "price"],
      "properties": {
        "no": {"type": "integer"},
        "sku": {"type": "string"},
        "quantity": {"type": "integer"},
        "price": {"type": "number"},
        "currency": {"type": ["string", "null"]}
      }
    }
  }
}
