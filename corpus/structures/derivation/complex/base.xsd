<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture (#95): the base type that derived.xsd extends and restricts, in a namespace of its
     own; its local elements and attributes have none -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:flottila:corpus:base">
  <xs:complexType name="Party">
    <xs:sequence>
      <xs:element name="Name" type="xs:string"/>
      <xs:element name="Phone" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="since" type="xs:date"/>
    <xs:attribute name="note" type="xs:string"/>
  </xs:complexType>
</xs:schema>
