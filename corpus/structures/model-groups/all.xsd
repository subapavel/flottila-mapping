<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture (#94): xs:all keeps the declared order, and its own occurrence multiplies into its
     elements; the group Bag holds an xs:all (ADR-0008). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:g="urn:flottila:corpus:groups"
           targetNamespace="urn:flottila:corpus:groups">
  <xs:group name="Bag">
    <xs:all>
      <xs:element name="Sku" type="xs:string"/>
    </xs:all>
  </xs:group>
  <xs:element name="Doc">
    <xs:complexType>
      <xs:all minOccurs="0">
        <xs:element name="Zeta" type="xs:string"/>
        <xs:element name="Alpha" type="xs:date" minOccurs="0"/>
        <xs:element name="Line">
          <xs:complexType>
            <xs:group ref="g:Bag"/>
            <xs:attribute name="no" type="xs:integer"/>
          </xs:complexType>
        </xs:element>
      </xs:all>
      <xs:attribute name="code" type="xs:string"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
