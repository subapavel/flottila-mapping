<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic target of the orders bench mapping (ADR-0002, ADR-0021): one Order per sales order, an
     Item per line, and a Pick per line of every order, flattened. Every leaf is a string. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:flottila:corpus:bench:orders"
           xmlns="urn:flottila:corpus:bench:orders"
           elementFormDefault="qualified">
  <xs:element name="OrderBatch">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Order" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Number" type="xs:string"/>
              <xs:element name="Placed" type="xs:string"/>
              <xs:element name="Customer" type="xs:string"/>
              <xs:element name="Item" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Sku" type="xs:string"/>
                    <xs:element name="Quantity" type="xs:string"/>
                    <xs:element name="Price" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Pick" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Warehouse" type="xs:string"/>
              <xs:element name="Sku" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
