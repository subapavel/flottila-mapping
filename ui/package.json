{
  "name": "flottila-mapping-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "e2e": "playwright test",
    "e2e:stack": "playwright test --config playwright.stack.config.ts",
    "licences": "node --test scripts/*.test.mjs && node scripts/check-licences.mjs",
    "gen:types": "openapi-typescript ../contract/openapi.json -o src/generated/api.ts && json2ts -i ../contract/mapping-model.schema.json -o src/generated/mapping-model.ts && json2ts -i ../contract/function-catalogue.schema.json -o src/generated/function-catalogue.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@patternfly/react-core": "6.7.0",
    "@patternfly/react-table": "6.7.0",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-virtual": "3.14.26",
    "@xyflow/react": "12.12.1",
    "immer": "11.2.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
